# LVL UP v2 — environment variables.
#
# Copy this file to .env.local for local work, and set the same names in the
# Hostinger Node app settings for the deploy. Never commit a filled-in copy:
# .gitignore keeps every .env* out of git except this example.
#
# Full walkthrough: docs/admin-setup.md


# ---------------------------------------------------------------- Supabase ----

# Your project's API URL, e.g. https://abcdefghijklmnop.supabase.co
# Supabase dashboard -> Project Settings -> API -> Project URL.
NEXT_PUBLIC_SUPABASE_URL=

# The public anon key (newer dashboards call it the publishable key).
# Supabase dashboard -> Project Settings -> API -> Project API keys -> anon.
# This one is meant to reach the browser. It grants no access on its own: every
# table has row-level security enabled in supabase/migrations/0001_init.sql, so
# a request carrying only this key and no signed-in staff session reads nothing.
# Row-level security is the boundary, not the secrecy of this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service role key. Bypasses row-level security completely — it is a master
# key to the database. Supabase dashboard -> Project Settings -> API ->
# Project API keys -> service_role (press Reveal).
# Server-only: never give it a NEXT_PUBLIC_ prefix, never reference it from a
# client component, and do not set it in any browser-facing config. The only
# thing in this repo that uses it is scripts/create-owner.mjs, which creates the
# first owner account. Leaving it unset in production is correct and safe.
SUPABASE_SERVICE_ROLE_KEY=


# ------------------------------------------------------------------ Search ----

# Whether search engines may index this build (see lib/seo.ts).
# Anything other than the exact string true keeps robots.txt and the robots meta
# tag closed. Set it to true only on the real production build, once content/
# holds real business details rather than placeholders.
# /admin is excluded regardless of this flag.
SITE_INDEXABLE=false
